# ============================================================================
# VYVRE SaaS — Environment variables
#
# Copy this to .env.local and fill in your secrets.
# Never commit .env.local to git.
# ============================================================================

# ─── Stripe (LIVE MODE) ──────────────────────────────────────────────────
# Dashboard → Developers → API keys → Reveal LIVE secret key
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Developers → Webhooks → Add endpoint → vyvre.fr/api/stripe/webhook
# Copy the Signing secret (whsec_xxx)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional : publishable key for client-side checkout flows
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (Region eu-west-1 / Dublin) ────────────────────────────────
# Supabase Dashboard → Project "vyvre" → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ─── Resend (transactional email) ────────────────────────────────────────
# resend.com → API Keys → Create
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Domaine doit être vérifié dans Resend (SPF + DKIM dans DNS GoDaddy)
RESEND_FROM_EMAIL=VYVRE <hello@vyvre.fr>
RESEND_REPLY_TO=charles@vyvre.fr

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vyvre.fr
NEXT_PUBLIC_CDN_URL=https://vyvre.fr
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/charles-symphonydrive

# ─── Cron secret (for /api/cron/* endpoints, Vercel Cron) ────────────────
CRON_SECRET=generate-a-random-32-char-string-here
